# ==============================================================================
# Nexora AI Support Hub - Environment Configurations (Example Template)
# Copy this file to '.env' and fill in your actual local configuration settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configurations
# ------------------------------------------------------------------------------
APP_NAME="Nexora AI Support Hub API"
APP_ENV="development" # development, staging, production
DEBUG=true
API_V1_PREFIX="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:3000"

# CORS origins (comma-separated list for backend verification)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB Database configuration
# The backend will start and report "unavailable" or "not_configured" if not set.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="nexora_support_db"

# JWT & Cookie Security configurations
# Change JWT_SECRET_KEY to a secure 32-character key in your local .env
JWT_SECRET_KEY="nAj-OdQpM7UavEpHh4fKng2J4QrIXqI2Z7T-DKXRPfTXWB74kaKd3KCWFQ2EVvBIPzUUcMB1zpPYu4UvkCcpyw"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME="refresh_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# RAG & Knowledge Base configurations
EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
MAX_KNOWLEDGE_FILE_SIZE_MB=10

# Gemini API configurations
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# ------------------------------------------------------------------------------
# Frontend Configurations
# ------------------------------------------------------------------------------
# Centralized API base URL pointing to the backend FastAPI server
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
