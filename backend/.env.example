# FastAPI Environment Configurations
APP_NAME="Nexora AI Support Hub API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:3000"

# CORS configurations
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB Database configurations
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="nexora_support_db"

# JWT & Cookie Security configurations
# Change JWT_SECRET_KEY to a secure 32-character key in your local .env
JWT_SECRET_KEY="placeholder_for_local_development_change_me_must_be_32_characters_long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME="refresh_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# RAG & Knowledge Base configurations
EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
MAX_KNOWLEDGE_FILE_SIZE_MB=10

# Gemini API configurations
GEMINI_API_KEY="api_key"
GEMINI_MODEL="gemini-2.5-flash"
